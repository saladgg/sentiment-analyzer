# ==========================================================
# sentiment-analyzer - Environment Variables
# ==========================================================
# Copy this file to .env and adjust values for your environment.
# All variables are prefixed with ASA_ (AllSentimentAnalyzer).
# Full reference: docs/configuration.md
# ----------------------------------------------------------

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
ASA_APP_NAME=SentimentAnalyzer
ASA_ENVIRONMENT=dev                    # dev | staging | prod
ASA_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# ----------------------------------------------------------
# Security
# ----------------------------------------------------------
# Comma-separated API keys accepted in the X-API-Key header.
# Required when ASA_ENVIRONMENT is staging or prod (the app refuses to start otherwise).
ASA_API_KEYS=
# Comma-separated browser origins allowed by CORS.
ASA_CORS_ORIGINS=http://localhost:8501,http://localhost:5173

# ----------------------------------------------------------
# Input limits
# ----------------------------------------------------------
ASA_MAX_UPLOAD_BYTES=10485760          # 10 MB per request / file
ASA_MAX_RECORDS=10000                  # records per run
ASA_MAX_TEXT_CHARS=5000                # longer texts are truncated and flagged
ASA_MAX_LLM_RECORDS=500                # records per run for the paid llm engine

# ----------------------------------------------------------
# Sentiment engines
# ----------------------------------------------------------
ASA_DEFAULT_SENTIMENT_ENGINE=rule_based   # rule_based | hf_transformer | llm
ASA_WARMUP_DEFAULT_ENGINE=true

ASA_HF_SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
ASA_HF_MODEL_REVISION=                 # pin a commit hash for reproducible results
ASA_HF_NEUTRAL_BAND=0.0                # e.g. 0.1: binary-model predictions with p in 0.4-0.6 become neutral

# LLM engine (any litellm-supported provider). The engine is unavailable until a model is set.
ASA_LLM_API_KEY=                       # API key for your provider
ASA_LLM_MODEL=                         # e.g. gpt-4o, anthropic/claude-sonnet-4-5, ollama/llama3
ASA_LLM_TIMEOUT=60
ASA_LLM_NUM_RETRIES=2
ASA_LLM_CONCURRENCY=8

# ----------------------------------------------------------
# RAG
# ----------------------------------------------------------
ASA_RAG_ENABLED=true
ASA_RAG_TOP_K=5
ASA_RAG_NAMESPACE=default
ASA_VECTOR_STORE_PATH=./vector_store   # directory for the persistent Chroma store
ASA_RAG_CHUNK_SIZE=500
ASA_RAG_CHUNK_OVERLAP=50

# ----------------------------------------------------------
# Storage
# ----------------------------------------------------------
ASA_RUNS_DB_PATH=runs.duckdb           # (ASA_RAG_DB_PATH is a deprecated alias)

# ----------------------------------------------------------
# Frontend (Streamlit)
# ----------------------------------------------------------
ASA_API_URL=http://localhost:8000/api/v1
ASA_API_KEY=                           # one of ASA_API_KEYS when auth is enabled
